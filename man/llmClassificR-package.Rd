\section{Quick Example}{

\preformatted{
library(llmClassificR)
data(extraversion)

# Classify with multiple methods
res1 <- classify_direct(extraversion$text, unique(extraversion$subtopic))
res2 <- classify_cot(extraversion$text, unique(extraversion$subtopic))
res3 <- classify_judge(extraversion$text, unique(extraversion$subtopic))

# Compare
compare_methods(
  true_labels = extraversion$subtopic,
  "Direct" = res1,
  "Chain-of-Thought" = res2,
  "LLM-as-Judge" = res3
)
}
}

